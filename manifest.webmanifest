{
  "name": "Vathography Studio",
  "short_name": "Vathography",
  "description": "Turn photographs into vathographs: artworks drawn from the depth of a scene.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0b0b0c",
  "theme_color": "#0b0b0c",
  "categories": ["photo", "graphics", "design"],
  "icons": [
    { "src": "icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "image/*": [".jpg", ".jpeg", ".png", ".webp", ".avif"] } }
  ]
}
